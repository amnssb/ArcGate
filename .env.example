# ==== 必填 ====

# Obsidian Arc 站点地址（不带末尾斜杠），例如 https://arc.example.com
OBSIDIAN_ARC_URL=

# 站点后台「安全 → QQ 机器人 Webhook 令牌」处获取，不要提交到仓库
OBSIDIAN_ARC_BOT_TOKEN=

# ==== 可选 ====

# 要监听的群号，逗号分隔；留空 = 监听所有群
OBSIDIAN_ARC_WATCH_GROUPS=

# 接收 NapCat HTTP 上报的监听地址（默认 127.0.0.1:3002）
ARC_LISTEN_ADDR=127.0.0.1:3002

# NapCat HTTP API 地址（默认 http://127.0.0.1:3000）
ARC_ONEBOT_API_URL=http://127.0.0.1:3000

# NapCat 的 access token（NapCat 侧未设置则留空）
ARC_ONEBOT_ACCESS_TOKEN=

# 日志级别：debug | info（默认）| warn | error
ARC_LOG_LEVEL=info
